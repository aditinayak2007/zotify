
import tkinter as tk
from tkinter import ttk, messagebox

root = tk.Tk()
root.title("Banker's Algorithm Simulator")
root.geometry("900x650")
root.configure(bg="#eef2f7")

processes = tk.IntVar(value=5)
resources = tk.IntVar(value=3)

allocation_entries = []
max_entries = []
available_entries = []

# Header
header = tk.Frame(root, bg="#172554", pady=18)
header.pack(fill="x")

tk.Label(
    header,
    text="Banker's Algorithm Simulator",
    font=("Arial", 20, "bold"),
    bg="#172554",
    fg="white"
).pack()

tk.Label(
    header,
    text="Deadlock Avoidance and Safe State Analysis",
    font=("Arial", 10),
    bg="#172554",
    fg="white"
).pack()

# Configuration
config = tk.Frame(root, bg="#eef2f7", pady=12)
config.pack()

tk.Label(config, text="Processes:", bg="#eef2f7").grid(row=0, column=0)
tk.Spinbox(config, from_=1, to=10, textvariable=processes,
           width=5).grid(row=0, column=1, padx=8)

tk.Label(config, text="Resources:", bg="#eef2f7").grid(row=0, column=2)
tk.Spinbox(config, from_=1, to=8, textvariable=resources,
           width=5).grid(row=0, column=3, padx=8)

# Matrix input area
matrix_frame = tk.Frame(root, bg="#eef2f7")
matrix_frame.pack(pady=8)


def build_inputs():
    global allocation_entries, max_entries, available_entries

    for widget in matrix_frame.winfo_children():
        widget.destroy()

    allocation_entries = []
    max_entries = []
    available_entries = []

    p = processes.get()
    r = resources.get()

    allocation_frame = tk.LabelFrame(
        matrix_frame, text="Allocation Matrix", bg="white", padx=8, pady=8
    )
    allocation_frame.grid(row=0, column=0, padx=8, sticky="n")

    maximum_frame = tk.LabelFrame(
        matrix_frame, text="Maximum Matrix", bg="white", padx=8, pady=8
    )
    maximum_frame.grid(row=0, column=1, padx=8, sticky="n")

    available_frame = tk.LabelFrame(
        matrix_frame, text="Available Resources", bg="white", padx=8, pady=8
    )
    available_frame.grid(row=0, column=2, padx=8, sticky="n")

    for i in range(p):
        tk.Label(allocation_frame, text=f"P{i}", bg="white").grid(
            row=i, column=0
        )
        tk.Label(maximum_frame, text=f"P{i}", bg="white").grid(
            row=i, column=0
        )

        arow, mrow = [], []

        for j in range(r):
            a = tk.Entry(allocation_frame, width=4, justify="center")
            a.grid(row=i, column=j + 1, padx=2, pady=3)
            a.insert(0, "0")
            arow.append(a)

            m = tk.Entry(maximum_frame, width=4, justify="center")
            m.grid(row=i, column=j + 1, padx=2, pady=3)
            m.insert(0, "0")
            mrow.append(m)

        allocation_entries.append(arow)
        max_entries.append(mrow)

    for j in range(r):
        tk.Label(available_frame, text=f"R{j}", bg="white").grid(
            row=0, column=j
        )
        entry = tk.Entry(available_frame, width=4, justify="center")
        entry.grid(row=1, column=j, padx=2, pady=3)
        entry.insert(0, "0")
        available_entries.append(entry)


def read_inputs():
    try:
        allocation = [
            [int(e.get()) for e in row]
            for row in allocation_entries
        ]

        maximum = [
            [int(e.get()) for e in row]
            for row in max_entries
        ]

        available = [int(e.get()) for e in available_entries]

        if any(x < 0 for row in allocation + maximum for x in row):
            raise ValueError("Values cannot be negative.")

        if any(x < 0 for x in available):
            raise ValueError("Available values cannot be negative.")

        for i in range(processes.get()):
            for j in range(resources.get()):
                if allocation[i][j] > maximum[i][j]:
                    raise ValueError(
                        f"Allocation exceeds Max for P{i}, R{j}."
                    )

        need = [
            [maximum[i][j] - allocation[i][j]
             for j in range(resources.get())]
            for i in range(processes.get())
        ]

        return allocation, maximum, available, need

    except ValueError as error:
        messagebox.showerror("Input Error", str(error))
        return None


# Results window
result_frame = tk.LabelFrame(
    root, text="Results and Status", bg="white", padx=12, pady=10
)
result_frame.pack(fill="both", expand=True, padx=18, pady=10)

status = tk.Label(
    result_frame,
    text="Enter matrix values and select an operation.",
    bg="#dbeafe",
    fg="#172554",
    font=("Arial", 10, "bold"),
    pady=10
)
status.pack(fill="x", pady=(0, 8))

table = ttk.Treeview(result_frame, show="headings", height=7)
table.pack(fill="both", expand=True)


def show_need():
    data = read_inputs()
    if not data:
        return

    allocation, maximum, available, need = data

    table.delete(*table.get_children())
    columns = ["Process"] + [
        f"R{j}" for j in range(resources.get())
    ]
    table["columns"] = columns

    for col in columns:
        table.heading(col, text=col)
        table.column(col, width=100, anchor="center")

    for i, row in enumerate(need):
        table.insert("", "end", values=[f"P{i}"] + row)

    status.config(
        text="Need Matrix calculated: Need = Max - Allocation.",
        bg="#dbeafe",
        fg="#172554"
    )


def check_safety():
    data = read_inputs()
    if not data:
        return

    allocation, maximum, available, need = data
    p = processes.get()
    r = resources.get()

    work = available[:]
    finish = [False] * p
    sequence = []
    steps = []

    while len(sequence) < p:
        found = False

        for i in range(p):
            if not finish[i] and all(
                need[i][j] <= work[j] for j in range(r)
            ):
                before = work[:]
                work = [
                    work[j] + allocation[i][j]
                    for j in range(r)
                ]

                finish[i] = True
                sequence.append(i)
                steps.append(
                    (f"P{i}", before, work[:])
                )
                found = True

        if not found:
            break

    table.delete(*table.get_children())
    table["columns"] = ("Process", "Work Before", "Work After")

    for col in table["columns"]:
        table.heading(col, text=col)
        table.column(col, width=180, anchor="center")

    for process, before, after in steps:
        table.insert(
            "", "end",
            values=(process, before, after)
        )

    if all(finish):
        seq = " -> ".join(f"P{i}" for i in sequence)
        status.config(
            text=f"SAFE STATE | Safe Sequence: {seq}",
            bg="#dcfce7",
            fg="#166534"
        )
    else:
        blocked = [
            f"P{i}" for i in range(p) if not finish[i]
        ]
        status.config(
            text="UNSAFE STATE | Cannot finish: " + ", ".join(blocked),
            bg="#fee2e2",
            fg="#991b1b"
        )


def reset_results():
    table.delete(*table.get_children())
    status.config(
        text="Enter matrix values and select an operation.",
        bg="#dbeafe",
        fg="#172554"
    )


# Operation buttons
buttons = tk.Frame(root, bg="#eef2f7")
buttons.pack(pady=(0, 12))

ttk.Button(
    buttons, text="Build / Update Inputs",
    command=build_inputs
).grid(row=0, column=0, padx=5)

ttk.Button(
    buttons, text="Calculate Need",
    command=show_need
).grid(row=0, column=1, padx=5)

ttk.Button(
    buttons, text="Check Safe State",
    command=check_safety
).grid(row=0, column=2, padx=5)

ttk.Button(
    buttons, text="Reset Results",
    command=reset_results
).grid(row=0, column=3, padx=5)

build_inputs()
root.mainloop()
