
import tkinter as tk
from tkinter import ttk, messagebox


# Page Replacement Algorithms
def simulate(pages, capacity, algorithm):
    frames = []
    history = []
    hits = 0
    faults = 0
    last_used = {}
    fifo_pointer = 0

    for i, page in enumerate(pages):
        hit = page in frames

        if hit:
            hits += 1
            last_used[page] = i

        else:
            faults += 1

            if len(frames) < capacity:
                frames.append(page)

            elif algorithm == "FIFO":
                frames[fifo_pointer] = page
                fifo_pointer = (fifo_pointer + 1) % capacity

            elif algorithm == "LRU":
                victim = min(
                    frames,
                    key=lambda p: last_used.get(p, -1)
                )
                frames[frames.index(victim)] = page

            elif algorithm == "Optimal":
                future = pages[i + 1:]

                def next_use(p):
                    return (
                        future.index(p)
                        if p in future
                        else float("inf")
                    )

                victim = max(frames, key=next_use)
                frames[frames.index(victim)] = page

            last_used[page] = i

        history.append((page, frames.copy(), hit))

    return history, hits, faults


# Run Simulation
def run_simulation():
    try:
        raw_pages = page_entry.get().replace(",", " ").split()

        if not raw_pages:
            raise ValueError("Enter a page-reference string.")

        pages = [int(p) for p in raw_pages]
        capacity = int(frame_entry.get())

        if any(p < 0 for p in pages):
            raise ValueError("Page numbers cannot be negative.")

        if capacity < 1:
            raise ValueError("Number of frames must be at least 1.")

    except ValueError as error:
        messagebox.showerror("Input Error", str(error))
        return

    result_tree.delete(*result_tree.get_children())

    selected = algorithm_box.get()
    algorithms = (
        ["FIFO", "LRU", "Optimal"]
        if selected == "Compare All"
        else [selected]
    )

    summaries = []

    for algorithm in algorithms:
        history, hits, faults = simulate(
            pages, capacity, algorithm
        )

        ratio = faults / len(pages) * 100

        summaries.append(
            f"{algorithm}: Hits = {hits} | "
            f"Faults = {faults} | "
            f"Fault Ratio = {ratio:.2f}%"
        )

        for step, (page, frames, hit) in enumerate(history, 1):
            slots = frames + ["-"] * (capacity - len(frames))

            result_tree.insert(
                "",
                "end",
                values=(
                    algorithm,
                    step,
                    page,
                    " | ".join(map(str, slots)),
                    "HIT" if hit else "FAULT"
                ),
                tags=("hit" if hit else "fault",)
            )

    summary_label.config(text="\n".join(summaries))


# Clear Inputs and Results
def clear_all():
    page_entry.delete(0, tk.END)
    frame_entry.delete(0, tk.END)
    algorithm_box.set("Compare All")
    result_tree.delete(*result_tree.get_children())
    summary_label.config(text="Results will appear here.")


