#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <fcntl.h>

#define BUFFER_SIZE 256
#define LOG_FILE "yaseem.log"

/*
 * Logging Process
 *
 * Responsibilities:
 * 1. Receive information from Core through a POSIX pipe
 * 2. Record successful operations
 * 3. Record errors
 * 4. Record important events
 * 5. Store information in a log file
 */

void writeLog(const char *message)
{
    FILE *file = fopen(LOG_FILE, "a");

    if (file == NULL)
    {
        perror("Logger: Unable to open log file");
        return;
    }

    fprintf(file, "%s\n", message);

    fclose(file);
}

int main(int argc, char *argv[])
{
    char buffer[BUFFER_SIZE];

    /*
     * The Core passes the pipe's READ file descriptor
     * to the Logger.
     *
     * Example:
     * ./logger 3
     */

    if (argc != 2)
    {
        printf("Usage: %s <pipe_read_fd>\n", argv[0]);
        return 1;
    }

    int pipe_read_fd = atoi(argv[1]);

    printf("=====================================\n");
    printf(" LOGGING PROCESS\n");
    printf("=====================================\n");

    printf("[LOGGER] Waiting for messages from Core...\n");

    /*
     * Continuously receive information
     * from Core through the POSIX pipe.
     */

    while (1)
    {
        memset(buffer, 0, BUFFER_SIZE);

        ssize_t bytes_read =
            read(pipe_read_fd, buffer, BUFFER_SIZE - 1);

        /*
         * read() returns:
         * > 0 : data received
         *   0 : pipe closed by Core
         *  <0 : error
         */

        if (bytes_read > 0)
        {
            buffer[bytes_read] = '\0';

            /*
             * EXIT message means Core has finished.
             */

            if (strcmp(buffer, "LOGGER_EXIT") == 0)
            {
                writeLog("[IMPORTANT EVENT] Logging process terminated.");

                printf("[LOGGER] Core closed communication.\n");

                break;
            }

            /*
             * Display received information.
             */

            printf("[LOGGER] Received: %s\n", buffer);

            /*
             * Store the information in log file.
             */

            writeLog(buffer);
        }

        else if (bytes_read == 0)
        {
            /*
             * Core closed the pipe.
             */

            printf("[LOGGER] Pipe closed by Core.\n");
            break;
        }

        else
        {
            perror("Logger: read() failed");

            writeLog("[ERROR] Failed to read message from Core.");

            break;
        }
    }

    close(pipe_read_fd);

    printf("[LOGGER] Logs saved in %s\n", LOG_FILE);

    return 0;
}
