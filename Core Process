#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#define MAX_SIZE 100
#define BUFFER_SIZE 100

/* ================= MEMORY ================= */

int memory[MAX_SIZE];

/* Store data in memory */
void storeMemory(int address, int value)
{
    if (address >= 0 && address < MAX_SIZE)
    {
        memory[address] = value;
        printf("[CORE] Memory[%d] = %d\n", address, value);
    }
}

/* Read data from memory */
int loadMemory(int address)
{
    if (address >= 0 && address < MAX_SIZE)
    {
        return memory[address];
    }

    return -1;
}


/* ================= STACK ================= */

int stack[MAX_SIZE];
int top = -1;

void push(int value)
{
    if (top == MAX_SIZE - 1)
    {
        printf("[CORE] Stack Overflow\n");
        return;
    }

    stack[++top] = value;

    printf("[CORE] PUSH %d\n", value);
}

int pop()
{
    if (top == -1)
    {
        printf("[CORE] Stack Underflow\n");
        return -1;
    }

    return stack[top--];
}


/* ================= QUEUE ================= */

int queue[MAX_SIZE];
int front = 0;
int rear = -1;

void enqueue(int value)
{
    if (rear == MAX_SIZE - 1)
    {
        printf("[CORE] Queue Overflow\n");
        return;
    }

    queue[++rear] = value;

    printf("[CORE] ENQUEUE %d\n", value);
}

int dequeue()
{
    if (front > rear)
    {
        printf("[CORE] Queue Underflow\n");
        return -1;
    }

    return queue[front++];
}


/* ================= CPU ================= */

/*
   CPU executes the instruction received
   from the UI.
*/

void executeCommand(char command[], char result[])
{
    char operation[20];
    int a, b;
    int value;

    /* ADD */
    if (sscanf(command, "ADD %d %d", &a, &b) == 2)
    {
        value = a + b;

        sprintf(result,
                "CPU: %d + %d = %d",
                a, b, value);

        return;
    }

    /* SUB */
    if (sscanf(command, "SUB %d %d", &a, &b) == 2)
    {
        value = a - b;

        sprintf(result,
                "CPU: %d - %d = %d",
                a, b, value);

        return;
    }

    /* MUL */
    if (sscanf(command, "MUL %d %d", &a, &b) == 2)
    {
        value = a * b;

        sprintf(result,
                "CPU: %d * %d = %d",
                a, b, value);

        return;
    }

    /* DIV */
    if (sscanf(command, "DIV %d %d", &a, &b) == 2)
    {
        if (b == 0)
        {
            strcpy(result, "CPU: Division by zero");
            return;
        }

        value = a / b;

        sprintf(result,
                "CPU: %d / %d = %d",
                a, b, value);

        return;
    }

    /* PUSH */
    if (sscanf(command, "PUSH %d", &value) == 1)
    {
        push(value);

        sprintf(result,
                "Stack: Pushed %d",
                value);

        return;
    }

    /* POP */
    if (strcmp(command, "POP") == 0)
    {
        value = pop();

        sprintf(result,
                "Stack: Popped %d",
                value);

        return;
    }

    /* ENQUEUE */
    if (sscanf(command, "ENQUEUE %d", &value) == 1)
    {
        enqueue(value);

        sprintf(result,
                "Queue: Enqueued %d",
                value);

        return;
    }

    /* DEQUEUE */
    if (strcmp(command, "DEQUEUE") == 0)
    {
        value = dequeue();

        sprintf(result,
                "Queue: Dequeued %d",
                value);

        return;
    }

    /* STORE */
    if (sscanf(command, "STORE %d %d", &a, &b) == 2)
    {
        storeMemory(a, b);

        sprintf(result,
                "Memory: Stored %d at address %d",
                b, a);

        return;
    }

    /* LOAD */
    if (sscanf(command, "LOAD %d", &a) == 1)
    {
        value = loadMemory(a);

        sprintf(result,
                "Memory[%d] = %d",
                a, value);

        return;
    }

    /* Unknown command */
    strcpy(result, "Core: Invalid command");
}


/* ================= LOGGER ================= */

void logExecution(char command[], char result[])
{
    FILE *file;

    file = fopen("nireeksha_log.txt", "a");

    if (file == NULL)
    {
        return;
    }

    fprintf(file,
            "[CORE PID: %d] Command: %s | Result: %s\n",
            getpid(),
            command,
            result);

    fclose(file);
}


/* ================= CORE PROCESS ================= */

int main()
{
    char command[BUFFER_SIZE];
    char result[BUFFER_SIZE];

    printf("=====================================\n");
    printf("  CORE PROCESS\n");
    printf("=====================================\n");

    while (1)
    {
        /*
           Receive command from UI
           through pipe.
        */

        if (fgets(command, BUFFER_SIZE, stdin) == NULL)
        {
            break;
        }

        /* Remove newline */
        command[strcspn(command, "\n")] = '\0';

        /* EXIT */
        if (strcmp(command, "EXIT") == 0)
        {
            strcpy(result, "Core Process terminated");

            logExecution(command, result);

            printf("%s\n", result);

            break;
        }

        /*
           CPU / Memory / Stack / Queue
           processes the command.
        */

        executeCommand(command, result);

        /*
           Send important information
           to Logger.
        */

        logExecution(command, result);

        /*
           Send result back to UI
           through pipe.
        */

        printf("%s\n", result);
        fflush(stdout);
    }

    return 0;
}
